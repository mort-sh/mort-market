#!/usr/bin/env bash
# Test stub standing in for the real `grok` CLI.
# Records its argv (one arg per line) and emits canned output, all driven
# by environment variables so tests can script any grok behavior:
#   GROK_STUB_LOG          - file to write argv to, one argument per line
#   GROK_STUB_STDOUT       - literal stdout to emit
#   GROK_STUB_STDOUT_FILE  - file whose contents to emit on stdout (wins over GROK_STUB_STDOUT)
#   GROK_STUB_STDERR       - literal stderr to emit
#   GROK_STUB_EXIT         - exit code (default 0)
#   GROK_STUB_SLEEP        - seconds to sleep before responding (timeout tests)

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
  echo "grok 0.0.0-stub (deadbeef) [stub]"
  exit 0
fi

if [ -n "${GROK_STUB_LOG:-}" ]; then
  printf '%s\n' "$@" > "$GROK_STUB_LOG"
fi

if [ -n "${GROK_STUB_SLEEP:-}" ]; then
  sleep "$GROK_STUB_SLEEP"
fi

if [ -n "${GROK_STUB_STDERR:-}" ]; then
  printf '%s\n' "$GROK_STUB_STDERR" >&2
fi

if [ -n "${GROK_STUB_STDOUT_FILE:-}" ]; then
  cat "$GROK_STUB_STDOUT_FILE"
elif [ -n "${GROK_STUB_STDOUT:-}" ]; then
  printf '%s\n' "$GROK_STUB_STDOUT"
else
  printf '{"type":"result","result":"stub-ok","session_id":"stub-session-1234"}\n'
fi

exit "${GROK_STUB_EXIT:-0}"
